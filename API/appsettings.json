{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ats_resume_db;Username=postgres;Password=YOUR_PASSWORD;"
  },
  "RequestLimits": {
    "MaxRequestBodySizeBytes": 1048576
  },
  "Jwt": {
    "Issuer": "ResuMatch.Api",
    "Audience": "ResuMatch.Client",
    "SecretKey": "",
    "AccessTokenExpirationMinutes": 60
  },
  "JobPostingParseDrafts": {
    "WorkerEnabled": false,
    "ProviderExecutionEnabled": false,
    "PurgeEnabled": false,
    "ParseRateLimitEnabled": true,
    "ParseRequestsPerWindow": 10,
    "ParseRateLimitWindow": "00:15:00",
    "ParseRateLimitQueueLimit": 0,
    "ParseCooldown": "00:10:00",
    "PollInterval": "00:00:05",
    "Lifetime": "1.00:00:00",
    "LeaseDuration": "00:05:00",
    "MaximumAttempts": 3,
    "ProviderTimeout": "00:00:30",
    "FinalizationSafetyMargin": "00:00:15",
    "RetryBaseDelay": "00:00:10",
    "RetryMaximumDelay": "00:10:00",
    "RetryJitterMaximum": "00:00:03",
    "ShutdownGracePeriod": "00:00:30",
    "RetentionPeriod": "30.00:00:00",
    "PurgeBatchSize": 100,
    "PurgePollInterval": "01:00:00",
    "DistributedProviderScope": "job-description-extraction",
    "DistributedMaxConcurrentRequests": 1,
    "ProviderCapacityRetryDelay": "00:00:05",
    "CircuitBreakerEnabled": true,
    "CircuitBreakerFailureThreshold": 3,
    "CircuitBreakerOpenDuration": "00:01:00",
    "CircuitBreakerHalfOpenMaxProbes": 1
  },
  "Observability": {
    "Enabled": false,
    "TracingEnabled": true,
    "MetricsEnabled": true,
    "OtlpEnabled": false,
    "OtlpEndpoint": "",
    "RequireSecureOtlpTransport": false,
    "OtlpExportTimeout": "00:00:05",
    "OperationalSamplerEnabled": true,
    "OperationalSamplerInterval": "00:00:30",
    "DatabaseCheckTimeout": "00:00:03"
  },
  "JobDescriptionExtraction": {
    "Provider": "Unavailable",
    "Model": "",
    "RequirePinnedModel": false,
    "ModelIsPinned": false,
    "MaxInputCharacters": 50250,
    "MaxOutputTokens": 4096,
    "MaxConcurrentRequests": 1,
    "RequestTimeout": "00:00:25"
  },
  "AiUsageBudget": {
    "Enabled": false,
    "User": {
      "DailyRequestLimit": 100,
      "DailyTokenLimit": 1000000,
      "MonthlyRequestLimit": 2000,
      "MonthlyTokenLimit": 20000000
    },
    "System": {
      "DailyRequestLimit": 1000,
      "DailyTokenLimit": 10000000,
      "MonthlyRequestLimit": 30000,
      "MonthlyTokenLimit": 300000000
    },
    "Reservation": {
      "EstimatedInputTokens": 12000,
      "MaximumOutputTokens": 4096,
      "Lifetime": "00:30:00"
    },
    "Reconciliation": {
      "Enabled": false,
      "BatchSize": 100,
      "PollInterval": "01:00:00",
      "MinimumAge": "00:05:00",
      "LeaseDuration": "00:05:00",
      "Purge": {
        "Enabled": false,
        "RetentionPeriod": "90.00:00:00",
        "BatchSize": 100,
        "PollInterval": "01:00:00"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
